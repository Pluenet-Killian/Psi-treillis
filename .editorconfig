# Editor settings shared by the project (https://editorconfig.org). Sources are in UTF-8, indented by 4 spaces, with LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cu,cuh,h,cpp,c,py,ps1,sh}]
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_size = 2
